<!doctype html>
<html lang="ca" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <title>{{ title or siteData.name }}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Nunito:ital,wght@0,400..800;1,400..700&display=swap"
    >
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
    >
    <link rel="stylesheet" href="/assets/css/afa.css">

    <link rel="alternate" type="application/atom+xml" href="/feed.xml" />
    <script data-goatcounter="https://afasantateresa.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>

    <!-- metadata -->
    <meta name="version" content="{{versio}}">
    {%if image %}
    <meta property="og:image" content="{{ image }}" />
    {% else %}
    <meta property="og:image" content="{{ siteData.metadata.banner }}" />
    {%endif %}
    {% metagen
        title             = title,
        desc              = description,
        version           = version,
        url               = siteData.metadata.base + page.url,
        type              = type,
        site_name         = siteData.metadata.name,
        og_image_width    = image.width,
        og_image_height   = image.height,
        og_image_alt      = image.alt,
        og_image_type     = image.type,
        twitter_card_type = "summary_large_image",
        name              = author.name,
        generator         = 'eleventy',
        preconnect        = [siteData.metadata.base],
        dns_prefetch      = [siteData.metadata.base],
        css               = ['/assets/css/afa.css']
    %}
  </head>
  <body>
    <a class="skip-link" href="#contingut">Salta al contingut</a>

    <header class="site-header">
      <div class="wrap">
        <nav class="site-nav" aria-label="Seccions del web">
          <a class="brand" href="/">
            <img alt="Logo de l'AFA del CEIP Santa Teresa" src="/assets/imgs/logo_afa_color_500_fons_transparent.png" width="500" height="271"/>
          </a>

          <ul class="nav-links">
            {% for seccio in seccions %}
            {% set actiu = (page.url == seccio.url) or (seccio.url != "/" and page.url.startsWith(seccio.url)) %}
            <li><a href="{{ seccio.url }}"{% if actiu %} aria-current="page"{% endif %}>{{ seccio.titol }}</a></li>
            {% endfor %}
          </ul>

          <details class="nav-menu">
            <summary>
              <span>Menú</span>
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </summary>
            <ul>
              {% for seccio in seccions %}
              {% set actiu = (page.url == seccio.url) or (seccio.url != "/" and page.url.startsWith(seccio.url)) %}
              <li><a href="{{ seccio.url }}"{% if actiu %} aria-current="page"{% endif %}>{{ seccio.titol }}</a></li>
              {% endfor %}
            </ul>
          </details>
        </nav>
      </div>
    </header>

    <main class="wrap" id="contingut">
      <div class="page">
        <header class="page-hero">
          <h1>{{ title }}</h1>
          {% if content | toc %}
            {{ content | toc | safe }}
          {% endif %}
        </header>

        <div class="page-body">
          {% if actualitzat or date %}
          <p class="data">
            {% if actualitzat %}
            Actualitzat el <span data-tooltip="Versió {{ versio }}" data-placement="bottom">
              <time datetime="{{ actualitzat | comADataISO }}">{{ actualitzat | comAData }}</time>
            </span>
            {% endif %}
            {% if date %}
            <span data-tooltip="Versió {{ versio }}" data-placement="bottom">
              <time datetime="{{ date | comADataISO }}">{{ date | comAData }}</time>
            </span>
            {% endif %}
          </p>
          {% endif %}

          {{ content | safe }}
        </div>
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          Il·lustració de Virginia Lorente per a <a href="https://www.atypicalvalencia.com/">atypicalvalencia.com</a>
        </p>
        <p class="llicencia">
          <a class="cc-link" href="https://creativecommons.org/licenses/by-nc-nd/4.0/deed.ca" target="_blank" rel="license noopener noreferrer">
            <span class="cc-text">{{ page.date | comAny }}&copy; · CC BY-NC-ND 4.0</span>
            <span class="cc-icons" aria-hidden="true">
              <img src="https://mirrors.creativecommons.org/presskit/icons/cc.svg" alt="" width="22" height="22" loading="lazy">
            </span>
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
